# ==========================================
# RAX3000M NAND 官方稳定版 25.12 - 软件包配置 (最终修正版)
# 基于 immortalwrt/immortalwrt (openwrt-25.12)
# 目标平台: mediatek/filogic
# 设备: cmcc_rax3000m
# 内核: Linux 6.12
# 包管理器: apk
# 优化策略:
# 1. 科学上网改用 HomeProxy (官方自带，基于 Sing-box)，【已移除 Passwall2】
# 2. 【新增】AdBlock-Fast 广告拦截 + GNU 加速工具包 (gawk/grep/sed/coreutils-sort)
# 3. 移除 AdGuardHome (用 SmartDNS+MOSDNS)
# 4. Samba4 替换为 Ksmbd (高性能低占用)
# 5. 移除 FileBrowser
# 6. 移除 DiskMan (节省空间)
# 7. 移除 DDNS-GO (节省空间)
# 8. 保留 NetWizard (用户需要)
# ==========================================
# ---------- 中文界面 ----------
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# ---------- 主题美化 (KUCAT 酷猫) ----------
CONFIG_PACKAGE_luci-theme-kucat=y
CONFIG_PACKAGE_luci-app-kucat-config=y
CONFIG_PACKAGE_luci-i18n-kucat-config-zh-cn=y
#  安装 Argon 主题及配置插件
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
#  安装 Argon 配置插件的中文语言包
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
# ---------- 科学上网 (HomeProxy - 官方自带，基于 Sing-box，替代 Passwall2) ----------
# 特点：界面简洁，配置简单，官方维护，稳定
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
# ---------- 广告拦截 (AdBlock-Fast) ----------
# 高性能 DNS 级广告拦截，不驻留后台，低内存占用
CONFIG_PACKAGE_adblock-fast=y
CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_luci-i18n-adblock-fast-zh-cn=y
# 配套推荐包：GNU 版文本处理工具，大幅加快黑名单处理速度，避免启动失败
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_grep=y
CONFIG_PACKAGE_sed=y
CONFIG_PACKAGE_coreutils-sort=y
#-----------定时重启-----------------
CONFIG_PACKAGE_luci-app-autoreboot=y
# ---------- 虚拟组网 (ZeroTier) ----------
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
# ---------- DNS 优化 (MOSDNS + SmartDNS) ----------
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
# 【已移除】AdGuardHome (节省 ~10MB)
# CONFIG_PACKAGE_luci-app-adguardhome is not set
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_v2dat=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
# ---------- 局域网共享 (改用 Ksmbd - 高性能低占用) ----------
# 【已移除】Samba4 (节省 ~8MB)
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# 【新增】Ksmbd (内核态 SMB，体积 < 1MB)
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
# ---------- 硬盘休眠 (外接硬盘必备) ----------
CONFIG_PACKAGE_hd-idle=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y
# ---------- 远程控制 (DDNSTO) ----------
# 【已移除】DDNS-GO (节省 ~5-8MB)
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-i18n-ddnsto-zh-cn=y
# ---------- 磁盘管理 (PartExp) ----------
# 【已移除】DiskMan (节省 ~2MB)
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-i18n-partexp-zh-cn=y
# ---------- 终端 (ttyd) ----------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
# ---------- Lucky (大吉 - 端口转发/DDNS/内网穿透) ----------
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
# ---------- 应用商店 (iStore) ----------
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-i18n-store-zh-cn=y
# ---------- 系统监控 ( Bandix 实时带宽 + nlbwmon 带宽监控 + luci-app-flowlens) ----------
CONFIG_PACKAGE_luci-app-bandix=y
CONFIG_PACKAGE_luci-i18n-bandix-zh-cn=y
CONFIG_PACKAGE_bandix=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-flowlens=y
# ---------- 网络设置向导 (NetWizard) -----------
CONFIG_PACKAGE_luci-app-netwizard=y
CONFIG_PACKAGE_luci-i18n-netwizard-zh-cn=y
# ---------- 定时任务 (TaskPlan) ----------
CONFIG_PACKAGE_luci-app-taskplan=y
CONFIG_PACKAGE_luci-i18n-taskplan-zh-cn=y
# ---------- 基础依赖 ----------
CONFIG_PACKAGE_luci-compat=y
# ---------- 外接硬盘支持 ----------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_e2fsprogs=y
# ---------- 限速与流量控制 (SQM + EqosPlus) ----------
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-app-eqosplus=y
CONFIG_PACKAGE_luci-i18n-eqosplus-zh-cn=y
# ---------- 微信推送 (WeChatPush) ----------
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y
