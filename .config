CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cmcc_rax3000m=y

# --- 中文界面 ---
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# --- 科学上网 (Momo + sing-box，替代 Passwall) ---
CONFIG_PACKAGE_sing-box=y                  # Momo 的核心依赖 (sing-box >= 1.12)
CONFIG_PACKAGE_momo=y                      # Momo 核心程序
CONFIG_PACKAGE_luci-app-momo=y             # Momo 网页界面
CONFIG_PACKAGE_luci-i18n-momo-zh-cn=y      # Momo 中文语言包

# --- 网络加速 (Turbo ACC - BBR + Flow Offloading) ---
CONFIG_PACKAGE_luci-app-turboacc=y

# --- 局域网共享 (Samba4 - PT 必备) ---
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y

# --- PT 下载器 (Transmission) ---
CONFIG_PACKAGE_transmission-daemon-openssl=y
CONFIG_PACKAGE_luci-app-transmission=y
CONFIG_PACKAGE_luci-i18n-transmission-zh-cn=y

# --- 远程控制 (DDNSTO) ---
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-i18n-ddnsto-zh-cn=y

# --- 磁盘管理 (DiskMan) ---
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y

# --- 现代化文件管理器 (FileBrowser) ---
CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_luci-i18n-filebrowser-zh-cn=y

# --- 美化与终端 ---
CONFIG_PACKAGE_luci-theme-m3e=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# --- 其他实用神器 ---
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-gowebdav=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-kms-server=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_luci-app-socat=y

# --- 显式关闭 UPnP (PT 手动端口转发更稳) ---
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_miniupnpd is not set

# --- 外接硬盘支持 (你的 2.7T PT 仓库) ---
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_e2fsprogs=y
